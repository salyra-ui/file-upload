{
  "openapi": "3.1.0",
  "info": {
    "title": "Salyra Upload Protocol",
    "version": "1.0.0",
    "description": "Application authentication, route names and completed-file catalog remain configurable. Upload-Checksum is the lowercase hexadecimal SHA-256 of the request body. JSON sizes and offsets are safe integers."
  },
